[Unit]
Description=Doorman Raspberry Pi audio worker
Wants=pipewire.service wireplumber.service
After=pipewire.service wireplumber.service

[Service]
Type=simple
EnvironmentFile=%h/.config/doorman/audio-worker.env
ExecStart=/usr/bin/python3 /opt/doorman/pi/doorman_audio_worker.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
